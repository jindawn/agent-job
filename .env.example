# Leave LLM_API_KEY empty to run fully offline with the deterministic mock model.
LLM_API_KEY=
# Any OpenAI-compatible endpoint:
#   OpenAI    https://api.openai.com/v1
#   DeepSeek  https://api.deepseek.com/v1
#   Qwen      https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# Optional dense embeddings (same endpoint); empty = offline hashing embedder
EMBED_MODEL=
AGENT_MAX_STEPS=6
# Optional cost tracking (price per 1K tokens)
PRICE_IN_PER_1K=0
PRICE_OUT_PER_1K=0
